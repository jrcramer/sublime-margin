[
	{
		"id": "preferences",
		"children": [{
			"caption": "Package Settings",
			"mnemonic": "P",
			"id": "package-settings",
			"children": [{
				"caption": "Margin",
				"children": [{
					"caption": "Settings",
					"command": "edit_settings",
					"args": {
						"base_file": "${packages}/Margin/Margin.sublime-settings",
						"default": "{\n\t$0\n}\n"
					}
				}]
			}]
		}]
	}
]
